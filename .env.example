# ============================================================
# GreenSynth Analytics — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=greensynth
POSTGRES_PASSWORD=changeme
POSTGRES_DB=greensynth_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Backend ───────────────────────────────────────────────
# Async URL used by the FastAPI application
DATABASE_URL=postgresql+asyncpg://greensynth:changeme@db:5432/greensynth_db

# Sync URL used by Alembic for migrations
DATABASE_URL_SYNC=postgresql+psycopg2://greensynth:changeme@db:5432/greensynth_db

BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=true

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# ── Storage ───────────────────────────────────────────────
STORAGE_PATH=/data

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
