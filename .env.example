# ============================================================
# GreenSynth Analytics — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=greensynth
POSTGRES_PASSWORD=changeme
POSTGRES_DB=greensynth_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Backend ───────────────────────────────────────────────
# Async URL used by the FastAPI application
DATABASE_URL=postgresql+asyncpg://greensynth:changeme@db:5432/greensynth_db

# Sync URL used by Alembic for migrations
DATABASE_URL_SYNC=postgresql+psycopg2://greensynth:changeme@db:5432/greensynth_db

BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=true

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# ── Storage (Phase 9) ─────────────────────────────────
STORAGE_BACKEND=local
STORAGE_PATH=./data
RAW_DATA_DIR=./data/raw

# S3-Compatible Cloud Object Storage (Required when STORAGE_BACKEND=s3)
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=us-east-1
# S3_BUCKET=greensynth-raw-files
# S3_ACCESS_KEY_ID=your_s3_access_key_here
# S3_SECRET_ACCESS_KEY=your_s3_secret_key_here
# S3_PUBLIC_BASE_URL=
# S3_USE_SSL=true

# ── Email & SMTP Infrastructure (Phase 16) ─────────────
# Set EMAIL_MODE=smtp in production, or EMAIL_MODE=console for local testing/dev
EMAIL_MODE=console
EMAIL_ENABLED=true

# SMTP Server Settings (Default: Gmail SMTP TLS on port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=v.atharvan@gmail.com
# IMPORTANT: Generate a 16-character Gmail App Password at https://myaccount.google.com/apppasswords
# NEVER commit the actual App Password to version control!
SMTP_PASSWORD=
SMTP_FROM_EMAIL=v.atharvan@gmail.com
SMTP_FROM_NAME=GreenSynth Analytics
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30
FRONTEND_BASE_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
