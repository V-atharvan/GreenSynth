# ============================================================
# GreenSynth Analytics — .gitignore
# ============================================================

# ── Environment & Secrets ──────────────────────────────────
.env
.env.local
.env.*.local
*.secret

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.log

# ── Node / Frontend ───────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo

# ── Docker ────────────────────────────────────────────────
docker/secrets/

# ── IDE ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Data (raw lab data is gitignored except projects and P7 datasets for cloud deployment)
data/raw/*
data/processed/*
data/exports/*
backend/data/raw/*
backend/data/processed/*
backend/data/exports/*

# Track authentic research project datasets for cloud deployment on Render
!data/raw/projects/
!data/raw/P7/
!data/processed/projects/
!data/processed/P7/
!data/exports/.gitkeep
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep
!backend/data/exports/.gitkeep

# ── Database ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── ML models ─────────────────────────────────────────────
*.pkl
*.joblib
*.h5

# ── Scratch & Temporary ───────────────────────────────────
scratch/
*.lnk

# ── Alembic (keep versions tracked) ──────────────────────
# alembic/versions/ is intentionally tracked

