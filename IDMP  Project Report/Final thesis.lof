\contentsline {figure}{\numberline {5.1}{\ignorespaces Entity-Relationship (ER) Architecture of GreenSynth Analytics: Detailed relational model illustrating core tables, primary/foreign key mappings, and cascading integrity constraints.}}{52}{}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Executive Dashboard: Overview of active research initiatives, synthesis experiment counts, sample inventories, and recent characterization events.}}{57}{}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Experiment and Sample Management Interface: Logging synthesis run parameters, solution concentrations, substrate temperatures, and tracking sample lifecycles.}}{58}{}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces X-Ray Diffraction (XRD) Diffractogram Analysis Interface: Interactive $2\theta $ vs.\ Intensity pattern visualization showing raw background trace, Savitzky-Golay smoothed curve, and automated detection of 12 Bragg reflection peaks ($32.50^\circ $, $35.58^\circ $, $38.74^\circ $, $48.78^\circ $, $53.44^\circ $, $58.30^\circ $, $61.52^\circ $, $66.14^\circ $, $67.96^\circ $, $71.46^\circ $).}}{58}{}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces UV-Visible Optical Absorbance Spectrum Interface: Experimental absorbance curve ($A$ vs.\ $\lambda $) across $300\text { nm} \text {--} 800\text { nm}$ revealing the fundamental interband electronic absorption edge onset of synthesized nanostructured copper oxide.}}{59}{}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Automated Tauc Plot Optical Bandgap Extrapolation Interface: Direct allowed transition ($n=2$) $(A \cdot h\nu )^2$ vs.\ photon energy $h\nu $ curve with linear regression tangent extrapolation yielding an optical bandgap $E_g = 1.359\text { eV}$ ($R^2 = 0.9947$).}}{59}{}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Fourier-Transform Infrared (FTIR) Spectroscopic Analysis Interface: Transmittance spectrum ($T\%$ vs.\ wavenumber $\nu $ from $400\text { to }4000\text { cm}^{-1}$) with automated detection of 4 characteristic vibrational peaks ($536.0\text { cm}^{-1}$ $\text {Cu--O}$ lattice vibration, $1106.0\text { cm}^{-1}$, $1634.0\text { cm}^{-1}$, and $3408.0\text { cm}^{-1}$ hydroxyl stretching) alongside the researcher functional group annotation panel.}}{60}{}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Scanning Electron Microscopy (SEM) Micrograph Viewer and Scale Calibration Interface: Micrograph inspection of cauliflower-like nanostructured morphology at $50,000\times $ magnification ($15\text { kV}$ accelerating voltage, $8.5\text { mm}$ working distance, SE detector) with $500\text { nm}$ scale bar calibration and interactive digital caliper measurement tool.}}{61}{}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Electrical Property and Current-Voltage ($I\text {--}V$) Transport Analysis Interface: Experimental $I\text {--}V$ characteristic curve exhibiting Ohmic linearity, linear regression slope ($R = 2.50\,\Omega $), and automated resistance ($2.4991\,\Omega $) and conductivity calculation.}}{62}{}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Laboratory Precursor Extraction and Synthesis Realization: (a) Solid-liquid Soxhlet reflux apparatus for mulberry leaf extraction, (b) Hot plate magnetic stirrer during precursor compounding, (c) High-temperature muffle furnace for thermal processing, and (d) Digital conductivity meter for electrolyte solution monitoring.}}{63}{}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Analytical Characterization and Deposition Facilities: (a) Digital spectrophotometer instrumentation, (b) Ultraviolet fluorescence inspection cabinet, (c) Chemical precursor preparation table with precision analytical balance, and (d) Spray pyrolysis pneumatic compressor with substrate hot plate assembly.}}{64}{}%
